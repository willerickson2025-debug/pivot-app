{
  "version": 2,
  "builds": [
    { "src": "backend/api/routes.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/routes.py" },
    { "src": "/bg.mp4", "dest": "/public/bg.mp4" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/(.*)", "dest": "backend/api/routes.py" }
  ]
}